{
  "llm_config": {
    "model_name": "gpt-4.1"
  },
  "tools": [
    {
      "name": "news_analyst",
      "function": {
        "description": "\n    I can help you determine the level of policy for a date and region based on provided news articles.\n    Give me a date, region, policy, and news article URLs and I will provide you with a policy score for the date and region based on the news articles and historical data.\n    "
      },
      "instructions": "\nYou are a news article analyst. Your task is to assign a numeric policy score (based on provided guidelines) for a given region and date. You will carefully read news articles and consider relevant historical context to determine the correct score.\nExplicitly follow these steps. Do not skip any steps and do not return your final score and reasoning until you have completed all of them:\n\n1. Retrieve Historical Summary:\n    - Call the historian tool to get a summary of relevant past scores and notes.\n\n2. Load Guidelines:\n    - Call the ExtractDocs tool to retrieve the OxCGRT guidelines used for scoring.\n\n3. Scrape News Articles:\n    - Use the WebPageReaderTool to scrape the text of each news article from the provided URLs.\n\n4. Initial Analysis:\n    - Analyze each article individually, explicitly covering OxCGRT Technical Documentation: Clearly state how the reasoning aligns with the official OxCGRT scoring guidelines.\n    - Make sure the rationale behind the numeric score matches the table guidelines for the specific policy. Ensure that the rationale for your scoring does not fit better with a different score.\n    - Use the detailed interpretation guidance section for the specific policy.\n    - Cite specific parts of the guidelines that support your reasoning.\n        - If you are providing a score of 0 or 1, explain how your score follows the \"Delineating between policy levels 0 and 1\" section of the OxCGRT guidelines.\n    - Use the historical policy summary as context to inform your analysis, using the news articles to determine if the policy has changed from the previous score.\n    - Provide an explicit confidence level (high, medium, low) for your score. Clearly state any encountered ambiguity and how it impacts your scoring\n    - Do NOT use any internal knowledge of events that happened after the date you are scoring. Mention whenever you use any internal knowledge.\n\n5. Record Score\n    - Call the PersistorWriterTool to store your results in the archive.\n    - Provide it with the date, region, policy, score, and a brief one or two sentence summary of your reasoning, citing specific sections of articles, guidelines, or historical context that support your score.\n\nDo NOT return your final score and reasoning until you have completed all 5 of these steps.\n",
      "tools": [
        "historian",
        "ExtractDocs",
        "WebPageReaderTool",
        "PersistorWriterTool"
      ]
    },
    {
      "name": "historian",
      "function": {
        "description": "Returns relevant historical data from the archive for a given date, region, and policy. Then summarizes the data to help in scoring.",
        "parameters": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "A string containing the date to score the level of policy on."
            },
            "region": {
              "type": "string",
              "description": "A string containing the region to score the policy for."
            },
            "policy": {
              "type": "string",
              "description": "The policy whos level should be measured for the given date and region using the article and historical data."
            }
          },
          "required": [
            "date",
            "region",
            "policy"
          ]
        }
      },
      "instructions": "\nYou are a historian. Your task is to provide a concise, structured historical summary of relevant policy information for a given date, region, and policy.\nPerform the following clearly and succinctly:\n\n1. Retrieve Historical Data:\n    - Call the PersistorReaderTool to retrieve relevant recent policy records from the archive.\n\n2. Summarize Key Historical Points:\n    - Clearly summarize recent policy trends by highlighting recent policy escalations, easings, or continuations\n\n3. Format Summary:\n    - Structure your summary in the following format:\n        ### Historical Data Summary:\n            -**Region:** [Region Name]\n            -**Policy:** [Policy Name]\n            -**Recent Changes:**\n                - [Date]: [Brief description of change, e.g., \"Schools partially reopened in England, score changed from 3 to 2\"]\n                - (repeat for each recent change)\n",
      "tools": [
        "PersistorReaderTool"
      ],
      "command": "Retrieve relevant historical data from the archive for a given date, region, and policy. Then return a summary of the data."
    },
    {
      "name": "PersistorReaderTool",
      "function": {
        "description": "\nLoads relevant historical data from the archive for a given date, region, and policy.\nThe date, region, and policy must be passed as arguments.\nReturns recent scores for the given policy and region before or on the given date, and provides notes for each score.\nReturns the historical data sorted from oldest to newest as a JSON string. Here is an example in the expected format:\n        \"{\n            \"region\": \"England\",\n            \"policy\": \"C1E_School closing\",\n            \"historical_data\": [\n                {\n                    \"date\": \"2021-01-01\",\n                    \"score\": \"3\",\n                    \"notes\": \"All schools closed due to lockdown measures ...\"\n                },\n                ...\n            ]\n        }\"\n    You MUST call this tool to retrieve relevant historical data from the archive.\n            ",
        "parameters": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "A string containing the date to score the level of policy on."
            },
            "region": {
              "type": "string",
              "description": "A string containing the region to score the policy for."
            },
            "policy": {
              "type": "string",
              "description": "The policy that the article is being scored for."
            }
          },
          "required": [
            "date",
            "region",
            "policy"
          ]
        }
      },
      "class": "persistor_reader.PersistorReaderTool"
    },
    {
      "name": "ExtractDocs",
      "function": {
        "description": "\nReturns the text contents of all the files.\nYou MUST call this tool to read the text content of files.\n            ",
        "parameters": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "description": "The directory to read the text content of files from."
            }
          },
          "required": []
        }
      },
      "class": "extract_docs.ExtractDocs"
    },
    {
      "name": "WebPageReaderTool",
      "function": {
        "description": "\nScrapes the text of a single news article from a provided article_url.\nThe url pointing to the news article must be passed as an argument.\nYou MUST call this tool to scrape a specified news article.\n            ",
        "parameters": {
          "type": "object",
          "properties": {
            "article_url": {
              "type": "string",
              "description": "The url of the news article to be scraped."
            }
          },
          "required": [
            "article_url"
          ]
        }
      },
      "class": "webpage_reader.WebPageReaderTool"
    },
    {
      "name": "PersistorWriterTool",
      "function": {
        "description": "\nWrites newly scored data to the archive for a given date, region, policy, and score, as well as saving short notes giving reasoning for the score.\nThe date, region, policy, score, and notes must be passed as arguments.\nYou MUST call this tool to store newly scored data to the historical data archive.\n            ",
        "parameters": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "A string containing the date to score the level of policy on."
            },
            "region": {
              "type": "string",
              "description": "A string containing the region to score the policy for."
            },
            "policy": {
              "type": "string",
              "description": "The policy that the article is being scored for."
            },
            "score": {
              "type": "string",
              "description": "The score for the policy on the given date in the given region."
            },
            "notes": {
              "type": "string",
              "description": "A brief summary of the reasoning for the score."
            }
          },
          "required": [
            "date",
            "region",
            "policy",
            "score",
            "notes"
          ]
        }
      },
      "class": "persistor_writer.PersistorWriterTool"
    }
  ]
}